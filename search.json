[
  {"title":"Home — Doeun Kim","url":{{ '/' | relative_url | jsonify }},"summary":"Profile, research interests, and CV.","text":{{ site.data.profile | jsonify | jsonify }}},
  {"title":"Publications","url":{{ '/publications/' | relative_url | jsonify }},"summary":"Manuscripts under review and ICML workshop papers.","text":{{ site.data.publications | jsonify | jsonify }}},
  {"title":"Projects","url":{{ '/projects/' | relative_url | jsonify }},"summary":"All academic and technical projects, 2024–2026.","text":"machine learning systems software computer graphics data analysis"},
  {"title":"Curriculum vitae","url":{{ '/#cv' | relative_url | jsonify }},"summary":"Education, research experience, honors, academic service, skills, and CV download on Home.","text":{{ site.data.profile | jsonify | jsonify }}},
  {% for paper in site.data.publications %}{"title":{{ paper.title | jsonify }},"url":{{ '/publications/' | append: '#' | append: paper.id | relative_url | jsonify }},"summary":{% if paper.kind == 'manuscript' %}{{ paper.status | append: ', ' | append: paper.year | jsonify }}{% else %}{{ paper.venue | append: ' · Poster (non-archival)' | jsonify }}{% endif %},"text":{{ paper | jsonify | jsonify }}},{% endfor %}
  {% for project in site.data.projects %}{"title":{{ project.title | jsonify }},"url":{{ '/projects/' | append: '#' | append: project.id | relative_url | jsonify }},"summary":{{ project.period | append: ' · ' | append: project.category_label | jsonify }},"text":{{ project | jsonify | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
]